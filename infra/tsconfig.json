{
  // Pulumi type checks and runs index.ts with ts-node on every preview/up.
  // TypeScript stays on 6.x because Pulumi's ts-node doesn't support TS 7 yet.
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["index.ts"]
}
